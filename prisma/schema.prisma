generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// สินค้า (APK ที่ขาย)
model Product {
  id               String    @id @default(cuid())
  name             String
  shortDescription String?
  description      String
  features         String    // JSON array string
  price            Float
  apkUrl           String    // ลิงก์ดาวน์โหลด APK
  imageUrl         String?   // รูปภาพสินค้า
  category         String
  version          String?   // เวอร์ชัน APK
  size             String?   // ขนาดไฟล์
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tokens           Token[]
  payments         Payment[]
  downloads        Download[]
}

// Token สำหรับ Login + Download (NO DEVICE LOCK)
model Token {
  id            String    @id @default(cuid())
  token         String    @unique // 8 หลัก เช่น 12345678
  productId     String
  customerName  String
  customerPhone String
  downloadCount Int       @default(0) // นับจำนวนดาวน์โหลด
  lastUsedAt    DateTime? // ใช้ล่าสุดเมื่อไหร่
  expiresAt     DateTime? // วันหมดอายุ (optional)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id])
  downloads     Download[]

  @@index([token])
  @@index([productId])
}

// การชำระเงิน (PromptPay)
model Payment {
  id            String    @id @default(cuid())
  productId     String
  customerName  String
  customerPhone String
  amount        Float
  slipImageUrl  String?   // รูปสลิปโอนเงิน
  status        String    @default("pending") // pending, confirmed, rejected
  tokenId       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([productId])
}

// ประวัติการดาวน์โหลด (ไม่จำกัดจำนวนครั้ง)
model Download {
  id           String   @id @default(cuid())
  tokenId      String
  productId    String
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime @default(now())

  token        Token    @relation(fields: [tokenId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@index([tokenId])
}

// ตั้งค่าเว็บไซต์
model Settings {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
