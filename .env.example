# Database (Supabase PostgreSQL - สำหรับ Production)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# JWT Secret (ต้องมีอย่างน้อย 32 ตัวอักษร - สุ่มใหม่ทุกครั้ง)
JWT_SECRET="change-this-to-random-32-characters-or-more"

# Admin Credentials (เปลี่ยนเป็นของคุณเอง!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"

# Telegram Bot (Optional - สำหรับแจ้งเตือน)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhI..."
TELEGRAM_CHAT_ID="-1001234567890"

# App URL (Production - จะได้หลัง Deploy ครั้งแรก)
NEXT_PUBLIC_APP_URL="https://your-project-name.vercel.app"

# ⚠️ สำคัญ:
# 1. อย่า commit .env.local ขึ้น GitHub
# 2. ตั้งค่าทุกตัวแปรนี้ใน Vercel Environment Variables
# 3. เปลี่ยน JWT_SECRET และ ADMIN_PASSWORD ให้ปลอดภัย
